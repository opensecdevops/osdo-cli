# OSDO Security Pipeline — Basic
# Generated by: osdo init --template basic
# Scans: SAST (Semgrep) + SCA (OSV-Scanner) + Secrets (Gitleaks)

name: OSDO Security
on:
  push:
    branches: [{{defaultBranch}}]
  pull_request:
    branches: [{{defaultBranch}}]

permissions:
  contents: read
  security-events: write

jobs:
  sast:
    name: Static Analysis (SAST)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-sast@v2
        with:
          language: {{language}}
          fail-on: {{#if failOnCritical}}critical{{else}}none{{/if}}

  sca:
    name: Dependency Scan (SCA)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-sca@v2
        with:
          fail-on: {{#if failOnCritical}}critical{{else}}none{{/if}}

  secrets:
    name: Secret Detection
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-secrets-scan@v2
        with:
          fail-on-leak: true
