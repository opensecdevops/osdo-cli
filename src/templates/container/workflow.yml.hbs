# OSDO Security Pipeline — Container
# Generated by: osdo init --template container
# Scans: SAST + SCA + Secrets + Container Security + SBOM

name: OSDO Security
on:
  push:
    branches: [{{defaultBranch}}]
  pull_request:
    branches: [{{defaultBranch}}]

permissions:
  contents: read
  security-events: write
  packages: write

jobs:
  sast:
    name: Static Analysis (SAST)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-sast@v2
        with:
          language: {{language}}
          fail-on: {{#if failOnCritical}}critical{{else}}none{{/if}}

  sca:
    name: Dependency Scan (SCA)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-sca@v2
        with:
          fail-on: {{#if failOnCritical}}critical{{else}}none{{/if}}

  secrets:
    name: Secret Detection
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-secrets-scan@v2
        with:
          fail-on-leak: true

  container:
    name: Container Security
    runs-on: ubuntu-latest
    needs: [sast, sca, secrets]
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-container-scan@v2
        with:
          image: {{imageName}}
          fail-on: {{#if failOnCritical}}critical{{else}}none{{/if}}

  sbom:
    name: SBOM Generation
    runs-on: ubuntu-latest
    needs: [container]
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-sbom@v2
        with:
          image: {{imageName}}
          format: spdx-json
