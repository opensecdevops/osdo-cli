{
  "name": "container",
  "description": "Container security pipeline: SAST + SCA + Secrets + Container scan + SBOM",
  "version": "2.0.0",
  "blocks": [
    {
      "template": "workflow",
      "title": "Pipeline Configuration",
      "fields": [
        {
          "name": "defaultBranch",
          "label": "Default branch",
          "type": "select",
          "options": [
            {"id": "main", "value": "main"},
            {"id": "master", "value": "master"}
          ],
          "rules": {"required": true}
        },
        {
          "name": "language",
          "label": "Primary language",
          "type": "select",
          "options": [
            {"id": "auto", "value": "auto"},
            {"id": "javascript", "value": "javascript"},
            {"id": "python", "value": "python"},
            {"id": "go", "value": "go"},
            {"id": "java", "value": "java"}
          ],
          "rules": {"required": true}
        },
        {
          "name": "imageName",
          "label": "Container image name (e.g., myapp:latest)",
          "type": "text",
          "rules": {"required": true}
        },
        {
          "name": "failOnCritical",
          "label": "Fail on critical vulnerabilities?",
          "type": "checkbox",
          "rules": {}
        }
      ]
    }
  ]
}
