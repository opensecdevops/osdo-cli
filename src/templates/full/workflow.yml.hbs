# OSDO Security Pipeline — Full
# Generated by: osdo init --template full
# Scans: SAST + SCA + Secrets + Container + IaC + SBOM + Signing

name: OSDO Full Security Pipeline
on:
  push:
    branches: [{{defaultBranch}}]
  pull_request:
    branches: [{{defaultBranch}}]

permissions:
  contents: read
  security-events: write
  packages: write
  id-token: write

jobs:
  code-security:
    name: Code Security
    uses: opensecdevops/osdo-workflows/.github/workflows/osdo-framework.yml@v2
    with:
      scan-sast: true
      scan-sca: true
      scan-secrets: true
      language: {{language}}
      fail-on-critical: {{failOnCritical}}

  container-security:
    name: Container Security
    needs: [code-security]
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-container-scan@v2
        with:
          image: {{imageName}}
          fail-on: {{#if failOnCritical}}critical{{else}}none{{/if}}
      - uses: opensecdevops/osdo-sbom@v2
        with:
          image: {{imageName}}

  iac-security:
    name: Infrastructure as Code
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-iac-scan@v2
        with:
          framework: {{iacFramework}}
          fail-on: {{#if failOnCritical}}high{{else}}none{{/if}}

  sign:
    name: Artifact Signing
    needs: [container-security, iac-security]
    if: github.ref == 'refs/heads/{{defaultBranch}}'
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: opensecdevops/osdo-sign@v2
        with:
          image: {{imageName}}
